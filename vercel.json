{
  "version": 2,
  "name": "daoyuly-blog",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    }
  ],
  "routes": [
    {
      "src": "/atom\\.xml",
      "headers": {
        "Content-Type": "application/atom+xml; charset=utf-8",
        "Cache-Control": "public, max-age=300, s-maxage=300"
      },
      "dest": "/public/atom.xml"
    },
    {
      "src": "/rss\\.xml",
      "headers": {
        "Content-Type": "application/rss+xml; charset=utf-8",
        "Cache-Control": "public, max-age=300, s-maxage=300"
      },
      "dest": "/public/rss.xml"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
