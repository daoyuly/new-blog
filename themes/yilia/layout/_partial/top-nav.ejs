<header class="site-top-nav" role="banner">
  <div class="site-top-nav__inner">
    <div class="site-top-nav__brand">
      <a class="site-top-nav__brand-link<% if (is_home()) { %> is-active<% } %>" href="<%- url_for('/') %>"<% if (is_home()) { %> aria-current="page"<% } %>><%= config.title %></a>
    </div>
    <% if (theme.menu && Object.keys(theme.menu).length) { %>
    <nav class="site-top-nav__links" aria-label="站点导航">
      <%- partial('_partial/theme-menu', { mode: 'top' }) %>
      <% var feeds = rss_feeds(); var atom = feeds.find(function (feed) { return feed.type === 'atom'; }) || feeds[0]; if (atom) { %>
      <a id="nav-rss-link" class="rss" href="<%= url_for(atom.path) %>" title="RSS 订阅" aria-label="RSS 订阅">RSS</a>
      <% } %>
    </nav>
    <% } %>
  </div>
</header>
