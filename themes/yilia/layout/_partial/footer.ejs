<footer id="footer">
  <div class="outer">
    <% if (theme.footer_menu && Object.keys(theme.footer_menu).length) { %>
    <nav class="footer-nav" aria-label="更多">
      <% var fi = 0; %>
      <% for (var label in theme.footer_menu) { %>
        <% if (fi++ > 0) { %><span class="footer-nav-sep">·</span><% } %>
        <a href="<%- url_for(theme.footer_menu[label]) %>"><%= label %></a>
      <% } %>
    </nav>
    <% } %>
    <div id="footer-info">
      <div class="footer-left">
        &copy; <%= date(new Date(), 'YYYY') %> <%= config.author || config.title
        %>
      </div>
      <div class="footer-right">
        <a href="https://beian.miit.gov.cn/" target="_blank"
          >京ICP备16032693号</a
        >
      </div>
    </div>
  </div>
</footer>
