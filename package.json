{
  "name": "daoyu-blog",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "node tools/build-blog.js",
    "build:verified": "npm run build && npm run verify:feed",
    "verify:feed": "node tools/verify-feed.js",
    "test:feed": "node --test tests/feed-policy.test.js tests/verify-feed.test.js",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "start": "node server/index.js",
    "dev": "npm run build:verified && node server/index.js",
    "vercel-build": "npm run build:verified"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "feedsmith": "2.9.0",
    "hexo": "^7.2.0",
    "hexo-abbrlink": "^2.2.1",
    "hexo-filter-mermaid-diagrams": "^1.0.5",
    "hexo-front-matter": "4.2.1",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-baidu-sitemap": "^0.1.9",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-json-content": "^4.2.3",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.0.0",
    "hexo-renderer-stylus": "^2.1.0",
    "hexo-server": "^3.0.0",
    "hexo-util": "4.0.0"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.2"
  }
}
